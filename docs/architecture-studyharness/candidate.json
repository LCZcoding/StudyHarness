  "cards": [
    {
      "dot": "cyan",
      "title": "前端交互",
      "items": [
        "Vue 3.5 + Vite 5，开发端口 5173，Vue Router 4 组织页面",
        "普通接口走 Axios；流式对话用 fetch + ReadableStream 逐帧解析，绕开 Axios 的整包响应拦截器",
        "marked + DOMPurify 渲染对话、题面与材料的 markdown"
      ]
    },
    {
      "dot": "emerald",
      "title": "身份与异常",
      "items": [
        "登录下发 HttpOnly JSESSIONID，CurrentUserResolver 从服务端会话取 userId，客户端不自报身份",
        "11 个 Controller 只做参数与状态码，GlobalExceptionHandler 统一映射 401 / 403 / 400",
        "早期入口 GET /ai/manus/chat 无鉴权且未接前端，保留待接入"
      ]
    },
    {
      "dot": "violet",
      "title": "学习闭环",
      "items": [
        "资料 .md / .txt / .pdf 上传后按标题切章，章节是知识最小单元",
        "每章出 3 题（至少 1 道 EXPLAIN）；作答判分 PASS / PARTIAL / FAIL，单题最多 2 次",
        "复习按 1 → 3 → 7 天排期：PASS 走完置 DONE，PARTIAL 3 天，FAIL 次日，跳过推后 1 天"
      ]
    },
    {
      "dot": "amber",
      "title": "RAG 与模型",
      "items": [
        "LoveApp 用 ChatClient 组合系统提示词、会话记忆、RAG 与工具，底层为 qwen-plus",
        "BudgetedChatMemory 默认保留最近 8000 字符（30 条窗口），防止长会话顶爆上下文",
        "PgVectorStore 1024 维、余弦、HNSW；检索 filterExpression userId + topK 5，跨用户隔离"
      ]
    },
    {
      "dot": "rose",
      "title": "智能体与工具",
      "items": [
        "BaseAgent → ReActAgent → ToolCallAgent → LiManus，maxSteps 20",
        "8 个本地工具经 ToolRegistration 统一注册；chatClockTool 每轮常挂，chatWebTools 由联网开关控制",
        "MCP 工具经 SSE 合并；服务不可用时降级为仅本地工具"
      ]
    },
    {
      "dot": "slate",
      "title": "数据与观测",
      "items": [
        "12 个 JdbcTemplate 仓储手写 SQL，不引入 JPA",
        "10 张业务表 + vector_store；t_ai_call 记录场景、延迟、首 token、token 用量与成败",
        "MetricsService 汇总调用量、token、失败数与场景分布"
      ]
    }
  ]
}
