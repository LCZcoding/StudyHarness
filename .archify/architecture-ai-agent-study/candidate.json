  "cards": [
    {
      "dot": "cyan",
      "title": "前端",
      "items": [
        "Vue 3.5 + Vite 5，原生 EventSource 消费 SSE",
        "三个路由：主页 / 问题引导助手 / 超级智能体"
      ]
    },
    {
      "dot": "emerald",
      "title": "智能体架构",
      "items": [
        "BaseAgent → ReActAgent → ToolCallAgent → LiManus",
        "手动工具调用 internalToolExecutionEnabled(false)",
        "ReAct 循环结束后 produceFinalAnswer 生成总结",
        "ConversationStore 内存多轮记忆，按 chatId 隔离"
      ]
    },
    {
      "dot": "violet",
      "title": "工具系统",
      "items": [
        "工厂 + 适配器注册 8 个本地工具",
        "通过 SyncMcpToolCallbackProvider 合并 MCP 工具",
        "MCP 未启动时自动降级"
      ]
    },
    {
      "dot": "amber",
      "title": "记忆与 RAG",
      "items": [
        "问题引导助手：FileBasedChatMemory + pgvector RAG",
        "超级智能体：ConversationStore 内存多轮记忆"
      ]
    }
